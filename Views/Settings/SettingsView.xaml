<UserControl x:Class="WhatInsides.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="900">
    <Grid Background="{DynamicResource BrushBgApp}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="840" Margin="32,24,32,48" HorizontalAlignment="Stretch">
                <StackPanel>
                    <!-- Header Section -->
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Pengaturan" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Konfigurasi kata sandi, auto-lock, dan tampilan aplikasi." FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Section 1: Master Password -->
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Master Password" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Kata sandi utama untuk membuka dan mendekripsi berkas." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Password Input Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="5" Height="34" Padding="12,0" Margin="0,0,8,0">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="••••••••••••••••••••" FontFamily="{DynamicResource FontMono}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tersimpan" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#10B981" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button x:Name="BtnOpenChangePassModal" Click="BtnOpenChangePassModal_Click" Grid.Column="1" Style="{StaticResource StarkSecondaryButton}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconKey}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ubah Password" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Switch: System Tray -->
                    <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Jalankan di background (System Tray)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                <TextBlock Text="Sembunyikan jendela ke area notifikasi (dekat jam Windows) saat diminimalkan." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ChkSystemTray" Style="{StaticResource StarkToggleSwitch}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Switch: Windows Explorer Context Menu -->
                    <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Menu Klik Kanan Windows Explorer" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                        <TextBlock Text="HKCU\Software\Classes" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Tampilkan opsi '🔒 Kunci dengan WhatInsides' saat klik kanan berkas atau folder di Windows Explorer (Shift+F10 di Windows 11)." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="ChkExplorerIntegration" Click="ChkExplorerIntegration_Click" Style="{StaticResource StarkToggleSwitch}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Section 2: Otomatisasi & Kunci Sesi -->
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Otomatisasi &amp; Kunci Sesi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Kebijakan penguncian kembali saat sistem tidak aktif atau layar terkunci." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,24">
                        <!-- Toggle: Close / Minimize relock -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Kunci otomatis saat jendela diminimalkan" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Kunci kembali brankas dan minta master password saat jendela aplikasi diminimalkan." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkAutoRelockSettings" Style="{StaticResource StarkToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Dropdown: Inactivity Timeout -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Batas Waktu Inaktivitas" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Kunci otomatis berkas jika tidak ada aktivitas pengguna." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="CbInactivityTimeout" Style="{StaticResource StarkComboBox}" SelectedIndex="1" Width="190" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBoxItem Content="1 Menit"/>
                                    <ComboBoxItem Content="5 Menit (Rekomendasi)"/>
                                    <ComboBoxItem Content="15 Menit"/>
                                    <ComboBoxItem Content="Nonaktifkan"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Dropdown: Clipboard Auto-Clear -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Pembersihan Otomatis Clipboard" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Hapus otomatis kata sandi dan kode 2FA dari papan klip Windows setelah disalin." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="CbClipboardAutoClear" Style="{StaticResource StarkComboBox}" SelectedIndex="1" Width="190" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBoxItem Content="15 Detik"/>
                                    <ComboBoxItem Content="30 Detik (Rekomendasi)"/>
                                    <ComboBoxItem Content="60 Detik"/>
                                    <ComboBoxItem Content="Jangan Pernah"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Toggle: Win+L or Sleep -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Kunci saat layar terkunci atau sleep" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Otomatis mengunci enkripsi ketika Windows terkunci (Win+L) atau masuk mode tidur." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkLockOnSleep" Style="{StaticResource StarkToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row: Desktop Autofill & Global Hotkeys -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Autofill Aplikasi Desktop (Auto-Type)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="Ctrl + Alt + A" FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Otomatis mengisi username &amp; kata sandi ke aplikasi aktif (Zoom, Discord, Steam, dsb). Gunakan Ctrl+Shift+Space untuk Quick Spotlight Search." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkDesktopAutofill" Style="{StaticResource StarkToggleSwitch}" IsChecked="True" IsEnabled="False" ToolTip="Global Hotkey Aktif di Background" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row: SSH Agent & Git Security Authorization -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Integrasi SSH Agent &amp; Otorisasi Git" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="SSH_ASKPASS Bridge" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Tampilkan pop-up persetujuan WhatInsides Access Requested saat terminal (PowerShell, Git, SSH) meminta kunci privat." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkSshAgent" Style="{StaticResource StarkToggleSwitch}" IsChecked="True" IsEnabled="False" ToolTip="SSH Agent Otorisasi Siap" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Section 3: Integrasi Cloud & Google Drive -->
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Integrasi Cloud &amp; Google Drive" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Sinkronisasi cadangan kontainer terenkripsi secara otomatis ke penyimpanan cloud pribadi." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,24">
                        <!-- Row 1: Google Drive / Cloud Provider Status -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="87.3" Height="78">
                                                <Path Fill="#0066DA" Data="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3L27.5 53H0c0 1.55.4 3.1 1.2 4.5z"/>
                                                <Path Fill="#2684FC" Data="M59.8 53H27.5L13.75 76.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z"/>
                                                <Path Fill="#00AC47" Data="M43.65 25 29.9 1.2c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44A9.06 9.06 0 0 0 0 53h27.5z"/>
                                                <Path Fill="#00832D" Data="M43.65 25 57.4 1.2C56.05.4 54.5 0 52.9 0H34.4c-1.6 0-3.15.45-4.5 1.2z"/>
                                                <Path Fill="#FFBA00" Data="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3L43.65 25 59.8 53h27.45c0-1.55-.4-3.1-1.2-4.5z"/>
                                                <Path Fill="#EA4335" Data="M73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75L86.1 57.5c.8-1.4 1.2-2.95 1.2-4.5H59.798l5.852 11.5z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtCloudProviderName" Text="Google Drive" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Border x:Name="BorderCloudStatusBadge" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCloudStatusBadge" Text="Terhubung" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtCloudAccountOrPath" Text="user.vault@gmail.com" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnSyncDriveNow" Click="BtnSyncDriveNow_Click" Style="{StaticResource StarkSecondaryButton}" Height="30" Padding="10,0" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSync}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Sinkron Sekarang" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnCloudDisconnect" Click="BtnCloudDisconnect_Click" Style="{StaticResource StarkGhostButton}" Content="Putuskan" Height="30" Padding="10,0" FontSize="11.5" Foreground="{DynamicResource BrushDanger}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 2: Auto Upload on Lock -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Unggah otomatis berkas terenkripsi (.wisafe)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Secara otomatis mencadangkan snapshot kontainer ke Google Drive segera setelah proses penguncian selesai." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkCloudAutoUpload" Style="{StaticResource StarkToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 3: Folder Destination -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Folder Tujuan Cadangan" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Direktori penyimpanan jarak jauh pada Google Drive / OneDrive." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Height="30" Padding="10,0" Margin="0,0,6,0" MaxWidth="240">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCloudBackupDestination" Text="/WhatInsides Backup Vault" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="BtnCloudChangeFolder" Click="BtnCloudChangeFolder_Click" Style="{StaticResource StarkSecondaryButton}" Content="Ubah Folder" Height="30" Padding="10,0" FontSize="11.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 4: Wi-Fi Only -->
                        <Border Padding="0,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sinkronisasi hanya saat terhubung Wi-Fi" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Hemat kuota data dengan menunda unggahan saat perangkat terdeteksi menggunakan koneksi berbayar/seluler." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkCloudWifiOnly" Style="{StaticResource StarkToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 5: E2E Encryption -->
                        <Border Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Enkripsi Zero-Knowledge End-to-End sebelum upload" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Nama berkas dan metadata di-scramble sebelum transmisi; Google tidak dapat membaca isi dokumen." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkCloudZeroKnowledge" Style="{StaticResource StarkToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Section 4: Keamanan & Kriptografi Table -->
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,4,0,14">
                        <StackPanel>
                            <TextBlock Text="Keamanan &amp; Kriptografi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Standar enkripsi yang diterapkan pada kontainer berkas WhatInsides." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,28">
                        <StackPanel>
                            <Border Padding="14,11" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Algoritma Enkripsi" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="AES-256-CBC" FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </Border>
                            <Border Padding="14,11" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Derivasi Kunci" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="PBKDF2 (SHA-256)" FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </Border>
                            <Border Padding="14,11" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Penyimpanan Kunci" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="Windows DPAPI" FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </Border>
                            <Border Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Penghapusan Berkas" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="DoD 5220.22-M" FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Bar (Simpan Perubahan & Toast) -->
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Perubahan akan diterapkan secara langsung ke sistem." FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnResetSettings" Click="BtnResetSettings_Click" Style="{StaticResource StarkGhostButton}" Content="Reset ke Standar" Height="34" Padding="14,0" Margin="0,0,10,0" FontSize="12"/>
                                <Button x:Name="BtnSaveSettings" Click="BtnSaveSettings_Click" Style="{StaticResource StarkPrimaryButton}" Height="34" Padding="18,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSave}" Fill="{DynamicResource BrushPrimaryText}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Simpan Perubahan" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- MODAL: UBAH MASTER PASSWORD -->
        <!-- ========================================== -->
        <Grid x:Name="OverlayChangePassword" Visibility="Collapsed" Background="#C0000000">
            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="Ubah Master Password" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Password baru akan digunakan untuk derivasi kunci enkripsi berkas." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16"/>

                    <!-- In-Modal Error Alert Banner -->
                    <Border x:Name="BorderChangePassError" Background="#20EF4444" BorderBrush="{DynamicResource BrushDanger}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconAlertCircle}" Fill="{DynamicResource BrushDanger}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtChangePassError" Text="Password lama salah!" FontSize="11.5" Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Password Lama -->
                    <TextBlock Text="Password Lama:" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PbOldPassword" Style="{StaticResource StarkPasswordBox}" Height="34" Margin="0,0,0,12" PasswordChanged="PbChangePass_PasswordChanged"/>

                    <!-- Password Baru -->
                    <TextBlock Text="Password Baru (minimal 6 karakter):" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PbNewPassword" Style="{StaticResource StarkPasswordBox}" Height="34" Margin="0,0,0,12" PasswordChanged="PbChangePass_PasswordChanged"/>

                    <!-- Konfirmasi Password Baru -->
                    <TextBlock Text="Konfirmasi Password Baru:" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PbConfirmPassword" Style="{StaticResource StarkPasswordBox}" Height="34" Margin="0,0,0,20" PasswordChanged="PbChangePass_PasswordChanged" KeyDown="PbConfirmPassword_KeyDown"/>

                    <Grid>
                        <Button x:Name="BtnCancelChangePass" Click="BtnCancelChangePass_Click" Style="{StaticResource StarkSecondaryButton}" Content="Batal" Width="80" HorizontalAlignment="Left"/>
                        <Button x:Name="BtnConfirmChangePass" Click="BtnConfirmChangePass_Click" Style="{StaticResource StarkPrimaryButton}" Content="Simpan Password" Width="140" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
