<Window x:Class="WhatInsides.Views.Credentials.QuickAutofillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WhatInsides.Converters"
        Title="WhatInsides Quick Autofill"
        Width="540" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource FontSans}"
        Foreground="{DynamicResource BrushTextPrimary}"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <conv:CredentialCategoryToColorConverter x:Key="CatColorConv"/>
        <conv:CredentialCategoryToGeometryConverter x:Key="CatGeoConv"/>
        <conv:CredentialToIconBrushConverter x:Key="BrandBrushConv"/>
        <conv:CredentialToIconGeometryConverter x:Key="BrandGeoConv"/>
    </Window.Resources>

    <Border Background="{DynamicResource BrushBgCard}" 
            BorderBrush="{DynamicResource BrushBorder}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Direction="270" ShadowDepth="8" Opacity="0.85" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Target Header -->
                <RowDefinition Height="Auto"/>
                <!-- Search Box -->
                <RowDefinition Height="Auto"/>
                <!-- Content List or Locked View -->
                <RowDefinition Height="*"/>
                <!-- Footer Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER: Target Application & Close Button -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="AUTOFILL AKTIF" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtDetectedAppBadge" Text="Target: Zoom" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    </StackPanel>

                    <Button x:Name="BtnCloseAutofill" Click="BtnCloseAutofill_Click" Style="{StaticResource StarkGhostButton}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" ToolTip="Tutup (Esc)">
                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextMuted}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. SEARCH BOX -->
            <Border Grid.Row="1" Padding="16,12,16,8">
                <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtAutofillSearch" Grid.Column="1" TextChanged="TxtAutofillSearch_TextChanged" PreviewKeyDown="TxtAutofillSearch_PreviewKeyDown" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="12.5" VerticalAlignment="Center" CaretBrush="{DynamicResource BrushPrimary}"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Ketik nama akun / layanan... (Zoom, Google, GitHub)" FontSize="12" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                    </Grid>
                </Border>
            </Border>

            <!-- 3. MAIN AREA: CREDENTIALS LIST OR AUTH PROMPT -->
            <Grid Grid.Row="2" Margin="16,4,16,8">
                <!-- Credentials List -->
                <ListBox x:Name="LstAutofillItems" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         MouseDoubleClick="LstAutofillItems_MouseDoubleClick"
                         KeyDown="LstAutofillItems_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A3B82F6"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Brand / Category Icon -->
                                <Border Grid.Column="0" Width="32" Height="32" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="{Binding Converter={StaticResource BrandGeoConv}}" Fill="{Binding Converter={StaticResource BrandBrushConv}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title & Username -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                        <Border Background="{DynamicResource BrushBgCard}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryDisplayName}" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Username, TargetNullValue='(Tanpa Username)'}" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Autofill Action Pill -->
                                <Border Grid.Column="2" Background="{DynamicResource BrushPrimary}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↵ Autofill" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel x:Name="PanelEmptyMatches" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">
                    <Path Data="{StaticResource IconShieldLock}" Fill="{DynamicResource BrushTextFaint}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Tidak ada akun yang cocok" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Coba cari dengan kata kunci lain di kolom pencarian di atas." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Vault Locked Overlay -->
                <Border x:Name="PanelVaultLocked" Visibility="Collapsed" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <StackPanel>
                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextPrimary}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Brankas Terkunci" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Masukkan Master Password untuk membuka autofill." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,14"/>

                        <PasswordBox x:Name="PbQuickUnlock" Style="{StaticResource StarkPasswordBox}" Height="34" Margin="0,0,0,8" KeyDown="PbQuickUnlock_KeyDown"/>
                        <TextBlock x:Name="TxtQuickUnlockError" Text="Password salah, silakan coba lagi." FontSize="11" Foreground="{DynamicResource BrushDanger}" Visibility="Collapsed" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                        <Button x:Name="BtnQuickUnlock" Click="BtnQuickUnlock_Click" Style="{StaticResource StarkPrimaryButton}" Content="Buka Kunci &amp; Lanjutkan" Height="32"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. FOOTER HELPER LEGEND -->
            <Border Grid.Row="3" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↵ Autofill Langsung" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,14,0"/>
                        <TextBlock Text="Ctrl+C Sandi" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,14,0"/>
                        <TextBlock Text="Ctrl+B Username" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,14,0"/>
                        <TextBlock Text="Ctrl+T Kode 2FA" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                    </StackPanel>
                    <TextBlock Text="Esc Tutup" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
