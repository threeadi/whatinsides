                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview Box -->
                                    <Border Grid.Column="0" Width="42" Height="42" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="ImgEditIconPreview" Width="24" Height="24" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path x:Name="PathEditIconPreview" Data="{StaticResource IconKey}" Fill="{DynamicResource BrushAccentBlue}" Width="22" Height="22" Stretch="Uniform" SnapsToDevicePixels="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Preset Dropdown -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtEditCredBrandHeader" Text="LOGO BRAND / APLIKASI" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbEditCredIconPreset" SelectionChanged="CmbEditCredIconPreset_SelectionChanged" Style="{StaticResource StarkComboBox}" Height="32" FontSize="11.5"/>
                                    </StackPanel>

                                    <!-- Custom Upload & Clear Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button x:Name="BtnUploadCustomIcon" Click="BtnUploadCustomIcon_Click" Style="{StaticResource StarkSecondaryButton}" Height="32" Padding="10,0" Margin="0,0,6,0" ToolTip="Unggah file gambar (PNG, JPG, ICO, SVG)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconUpload}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Upload..." FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnClearCustomIcon" Click="BtnClearCustomIcon_Click" Style="{StaticResource StarkGhostButton}" Height="32" Width="32" Padding="0" ToolTip="Reset ke Otomatis">
                                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextMuted}" Width="10.5" Height="10.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Username -->
                            <StackPanel x:Name="GroupEditUsername" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtEditCredUsernameHeader" Text="NAMA PENGGUNA / EMAIL" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEditCredUsernameHint" Text="nama@email.com" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox x:Name="TxtEditCredUsername" TextChanged="TxtEditCredInput_TextChanged" Style="{StaticResource StarkTextBox}" Height="34"/>
                            </StackPanel>

                            <!-- Password with Generator Trigger -->
                            <StackPanel x:Name="GroupEditPassword" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtEditCredPasswordHeader" Text="KATA SANDI" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEditCredPasswordHint" Text="Rahasia" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Button x:Name="BtnTogglePassGen" Click="BtnTogglePassGen_Click" Content="Buka Generator Sandi" Style="{StaticResource StarkGhostButton}" Height="18" Padding="4,0" FontSize="10.5" HorizontalAlignment="Right" Foreground="{DynamicResource BrushAccentBlue}"/>
                                </Grid>
                                <TextBox x:Name="TxtEditCredPassword" Style="{StaticResource StarkTextBox}" Height="34" FontFamily="{DynamicResource FontMono}"/>
                            </StackPanel>

                            <!-- Embedded Generator Popover / Box -->
                            <Border x:Name="BorderPassGenerator" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="GENERATOR KATA SANDI" FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnRegenPassword" Click="BtnRegenPassword_Click" Style="{StaticResource StarkGhostButton}" Width="24" Height="24" Padding="0" Margin="0,0,6,0" ToolTip="Buat Ulang">
                                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button x:Name="BtnApplyPassword" Click="BtnApplyPassword_Click" Style="{StaticResource StarkPrimaryButton}" Height="24" Padding="10,0" Content="Gunakan" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Generated Output Display -->
                                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtGeneratedPreview" Text="dipper-pulsar-proven-english-fay" FontFamily="{DynamicResource FontMono}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <!-- Strength Line -->
                                    <ProgressBar x:Name="PbPassStrength" Value="85" Maximum="100" Height="3" Foreground="{DynamicResource BrushSuccess}" Background="{DynamicResource BrushBorderSubtle}" BorderThickness="0" Margin="0,0,0,10"/>

                                    <!-- Controls -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Tipe:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CmbGenType" SelectionChanged="CmbGenType_SelectionChanged" Style="{StaticResource StarkComboBox}" Height="30" FontSize="11">
                                                <ComboBoxItem Content="Kata-Kata (Memorable)" IsSelected="True" Style="{StaticResource StarkComboBoxItem}"/>
                                                <ComboBoxItem Content="Karakter Acak" Style="{StaticResource StarkComboBoxItem}"/>
                                                <ComboBoxItem Content="PIN Angka" Style="{StaticResource StarkComboBoxItem}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Jumlah Kata / Panjang:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                                <TextBlock x:Name="TxtSliderBadge" Text="5" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderLength" Value="5" Minimum="3" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderLength_ValueChanged" VerticalAlignment="Center" Height="24"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Pemisah:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,2"/>
                                            <ComboBox x:Name="CmbSeparator" SelectionChanged="CmbSeparator_SelectionChanged" Style="{StaticResource StarkComboBox}" Height="30" FontSize="11">
                                                <ComboBoxItem Content="Tanda Hubung (-)" IsSelected="True" Style="{StaticResource StarkComboBoxItem}"/>
                                                <ComboBoxItem Content="Titik (.)" Style="{StaticResource StarkComboBoxItem}"/>
                                                <ComboBoxItem Content="Garis Bawah (_)" Style="{StaticResource StarkComboBoxItem}"/>
                                                <ComboBoxItem Content="Spasi ( )" Style="{StaticResource StarkComboBoxItem}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,0,0">
                                            <CheckBox x:Name="ChkCapitalize" Click="ChkCapitalize_Click" Style="{StaticResource StarkCheckBox}" Content="Kapitalkan Depan" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2FA / TOTP Secret Key -->
                            <StackPanel x:Name="GroupEditTotp" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtEditCredTotpHeader" Text="KODE RAHASIA 2FA / TOTP (BASE32, OPSIONAL)" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEditCredTotpHint" Text="JBSWY3DPEHPK3PXP" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox x:Name="TxtEditCredTotp" Style="{StaticResource StarkTextBox}" Height="34" FontFamily="{DynamicResource FontMono}" ToolTip="Contoh: JBSWY3DPEHPK3PXP"/>
                            </StackPanel>

                            <!-- URL -->
                            <StackPanel x:Name="GroupEditUrl" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtEditCredUrlHeader" Text="WEBSITE / URL LOGIN" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEditCredUrlHint" Text="https://..." FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox x:Name="TxtEditCredUrl" TextChanged="TxtEditCredInput_TextChanged" Style="{StaticResource StarkTextBox}" Height="34" FontFamily="{DynamicResource FontMono}"/>
                            </StackPanel>

                            <!-- Vault Partition & Tags -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="PARTISI PENYIMPANAN" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbEditCredPartition" Style="{StaticResource StarkComboBox}" Height="34" FontSize="11.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TAG LABEL (PISAHKAN KOMA)" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtEditCredTags" Style="{StaticResource StarkTextBox}" Height="34" ToolTip="#Gaming, #Pribadi"/>
                                </StackPanel>
                            </Grid>

                            <!-- Notes -->
                            <StackPanel x:Name="GroupEditNotes" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtEditCredNotesHeader" Text="CATATAN TERENKRIPSI" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEditCredNotesHint" Text="Teks bebas rahasia" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox x:Name="TxtEditCredNotes" Style="{StaticResource StarkTextBox}" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- Attachments in Editor -->
                            <StackPanel x:Name="GroupEditAttachments" Margin="0,0,0,4">
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="LAMPIRAN BERKAS TERENKRIPSI" FontFamily="{DynamicResource FontMono}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtEditAttachmentsCount" Text="(0)" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextFaint}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="BtnEditAddAttachment" Click="BtnEditAddAttachment_Click" Style="{StaticResource StarkGhostButton}" Height="20" Padding="6,0" FontSize="10.5" HorizontalAlignment="Right" Foreground="{DynamicResource BrushAccentBlue}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource BrushAccentBlue}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tambah Lampiran..." FontSize="10.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="LstEditAttachments">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconAttachFile}" Fill="{DynamicResource BrushAccentBlue}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                    <Button Tag="{Binding}" Click="BtnEditRemoveAttachment_Click" Style="{StaticResource StarkGhostButton}" Height="22" Width="22" Padding="0" HorizontalAlignment="Right" ToolTip="Hapus lampiran ini">
                                                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushDanger}" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="20,14">
                        <Grid>
                            <Button x:Name="BtnCancelCredEditor" Click="BtnCancelCredEditor_Click" Style="{StaticResource StarkSecondaryButton}" Content="Batal" HorizontalAlignment="Left" Width="85" Height="34"/>
                            <Button x:Name="BtnSaveCredEditor" Click="BtnSaveCredEditor_Click" Style="{StaticResource StarkPrimaryButton}" Content="Simpan Kredensial" HorizontalAlignment="Right" Width="145" Height="34"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
