                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource IconOpenInNew}" Fill="{DynamicResource BrushTextMuted}" Width="10.5" Height="10.5" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
