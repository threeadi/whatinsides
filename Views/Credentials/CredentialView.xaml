                                                                    <TextBlock Text=" • AES-256" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushAccentBlue}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Action Buttons -->
