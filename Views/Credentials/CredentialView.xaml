<UserControl x:Class="WhatInsides.Views.Credentials.CredentialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{DynamicResource BrushBgApp}">
        <!-- 3-Column Credential Layout -->
        <Grid Background="{DynamicResource BrushBgApp}">
            <Grid.ColumnDefinitions>
                <!-- Kolom 0: Sub-Sidebar Kategori -->
                <ColumnDefinition Width="200" MinWidth="160" MaxWidth="280"/>
                <!-- Splitter 1 -->
                <ColumnDefinition Width="1"/>
                <!-- Kolom 2: Daftar Item -->
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="440"/>
                <!-- Splitter 2 -->
                <ColumnDefinition Width="1"/>
                <!-- Kolom 4: Detail Panel -->
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- KOLOM 0: Kategori & Brankas -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Vault Selector -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="BRANKAS AKTIF" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextFaint}" Margin="0,0,0,6"/>
                        <Border x:Name="BorderActiveVaultSelector" MouseLeftButtonDown="BorderActiveVaultSelector_MouseLeftButtonDown" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Cursor="Hand" ToolTip="Pilih Brankas Partisi">
                            <Border.ContextMenu>
                                <ContextMenu x:Name="CmVaultPartitions">
                                    <MenuItem Header="Semua Brankas" Tag="ALL" Click="MenuItemVaultPartition_Click"/>
                                    <Separator Margin="4,2"/>
                                    <MenuItem Header="D:\ Data &amp; Games" Tag="D:\ Data &amp; Games" Click="MenuItemVaultPartition_Click"/>
                                    <MenuItem Header="E:\ Koleksi" Tag="E:\ Koleksi" Click="MenuItemVaultPartition_Click"/>
                                    <MenuItem Header="C:\ Windows &amp; System" Tag="C:\ Windows &amp; System" Click="MenuItemVaultPartition_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconShieldPerson}" Fill="{DynamicResource BrushAccentBlue}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCredActiveVault" Text="Semua Brankas" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Path Data="{StaticResource IconExpandMore}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        </StackPanel>
                    </Border>

                    <!-- Categories Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
                        <StackPanel>
                            <TextBlock Text="KATEGORI" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextFaint}" Margin="8,4,8,8"/>

                            <Button x:Name="BtnCredCatAll" Click="BtnCredCat_Click" Tag="All" Style="{StaticResource SidebarNavActive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconGridView}" Fill="{DynamicResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Semua Item" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="5,0.5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCatCountAll" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatFav" Click="BtnCredCat_Click" Tag="Favorite" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconStar}" Fill="#FBBF24" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Favorit" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountFav" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatLogin" Click="BtnCredCat_Click" Tag="Login" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconKey}" Fill="{DynamicResource BrushTextFaint}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Akun &amp; Login" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountLogin" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatFinance" Click="BtnCredCat_Click" Tag="Finance" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCreditCard}" Fill="{DynamicResource BrushTextFaint}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Keuangan &amp; Kartu" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountFinance" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatIdentity" Click="BtnCredCat_Click" Tag="Identity" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFingerprint}" Fill="{DynamicResource BrushTextFaint}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Identitas &amp; Dokumen" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountIdentity" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatNote" Click="BtnCredCat_Click" Tag="SecureNote" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDescription}" Fill="{DynamicResource BrushTextFaint}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Catatan &amp; Lisensi" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountNote" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatDevServer" Click="BtnCredCat_Click" Tag="DeveloperServer" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTerminal}" Fill="{DynamicResource BrushTextFaint}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Developer &amp; Server" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountDevServer" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatCrypto" Click="BtnCredCat_Click" Tag="CryptoSeed" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextFaint}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kripto &amp; Seed" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountCrypto" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnCredCatTrash" Click="BtnCredCat_Click" Tag="Trash" Style="{StaticResource SidebarNavInactive}" Height="30" Margin="0,0,0,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDelete}" Fill="{DynamicResource BrushTextFaint}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tempat Sampah" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCatCountTrash" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tags Section -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="TAG LABEL" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextFaint}" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button x:Name="BtnTagGaming" Click="BtnCredTag_Click" Tag="#Gaming" Content="#Gaming" Style="{StaticResource StarkGhostButton}" Height="22" Padding="6,1" FontSize="10" FontFamily="{DynamicResource FontMono}" Margin="0,0,4,4"/>
                                <Button x:Name="BtnTagPribadi" Click="BtnCredTag_Click" Tag="#Pribadi" Content="#Pribadi" Style="{StaticResource StarkGhostButton}" Height="22" Padding="6,1" FontSize="10" FontFamily="{DynamicResource FontMono}" Margin="0,0,4,4"/>
                                <Button x:Name="BtnTagKantor" Click="BtnCredTag_Click" Tag="#Kantor" Content="#Kantor" Style="{StaticResource StarkGhostButton}" Height="22" Padding="6,1" FontSize="10" FontFamily="{DynamicResource FontMono}" Margin="0,0,4,4"/>
                                <Button x:Name="BtnTagKeuangan" Click="BtnCredTag_Click" Tag="#Keuangan" Content="#Keuangan" Style="{StaticResource StarkGhostButton}" Height="22" Padding="6,1" FontSize="10" FontFamily="{DynamicResource FontMono}" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter 1: Kategori / Daftar Item -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BrushBorder}" ResizeDirection="Columns"/>

            <!-- KOLOM 2: Daftar Item -->
            <Border Grid.Column="2" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Bar -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCredViewTitle" Text="Semua Item" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCredTotalCount" Text="0" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnCredMoreActions" Click="BtnCredMoreActions_Click" Style="{StaticResource StarkGhostButton}" Height="26" Width="26" Padding="0" Margin="0,0,6,0" ToolTip="Impor / Ekspor Kredensial">
                                    <Path Data="{StaticResource IconMoreVert}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource StarkContextMenu}">
                                            <MenuItem Header="Ekspor ke JSON..." Click="MenuItemExportJson_Click"/>
                                            <MenuItem Header="Ekspor ke CSV..." Click="MenuItemExportCsv_Click"/>
                                            <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="4,2"/>
                                            <MenuItem Header="Impor dari File (JSON / CSV / Bitwarden)..." Click="MenuItemImport_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Button x:Name="BtnAddNewCred" Click="BtnAddNewCred_Click" Style="{StaticResource StarkPrimaryButton}" Height="26" Padding="10,0" ToolTip="Tambah Item Baru">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource BrushPrimaryText}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAddNewCredBtn" Text="Item Baru" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Search & Sort Row -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Height="28" Padding="8,0" Margin="0,0,6,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextFaint}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtCredSearch" Grid.Column="1" TextChanged="TxtCredSearch_TextChanged" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="11.5" VerticalAlignment="Center" CaretBrush="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnCredSort" Click="BtnCredSort_Click" Grid.Column="1" Style="{StaticResource StarkGhostButton}" Width="28" Height="28" Padding="0" ToolTip="Urutkan Kredensial">
                                <Path Data="{StaticResource IconSort}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- List of Credential Items -->
                    <ListBox x:Name="LstCredentials" Grid.Row="2" SelectionChanged="LstCredentials_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,10" Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardSelected}"/>
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushPrimary}"/>
                                                    <Setter TargetName="b" Property="BorderThickness" Value="3,0,0,1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Brand Logo / Custom Icon / Category Badge -->
                                    <Border Grid.Column="0" Width="30" Height="30" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Custom Image (if uploaded) -->
                                            <Image Source="{Binding Converter={StaticResource CredCustomIconSourceConv}}" Width="18" Height="18" Stretch="Uniform" Visibility="{Binding Converter={StaticResource CredHasCustomIconConv}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- Authentic Brand SVG Logo (Default / Built-in) -->
                                            <Path Data="{Binding Converter={StaticResource CredToIconGeoConv}}" Fill="{Binding Converter={StaticResource CredToIconBrushConv}}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False" Visibility="{Binding Converter={StaticResource CredHasSvgIconConv}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Middle Information -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Username}" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <!-- 2FA Pill -->
                                            <Border Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisConv}}" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,6,0">
                                                <TextBlock Text="2FA" FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentBlue}"/>
                                            </Border>
                                            <!-- Domain -->
                                            <TextBlock Text="{Binding DomainOnly}" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextFaint}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Star Favorite Icon Button -->
                                    <Button x:Name="BtnRowStarFav" Click="BtnRowStarFav_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="3,2" Margin="4,0,0,0" Cursor="Hand" ToolTip="Ubah Status Favorit" Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisConv}}">
                                        <Path Data="{Binding IsFavorite, Converter={StaticResource BoolToStarConv}}" Fill="#FBBF24" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter 2: Daftar Item / Detail Panel -->
            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BrushBorder}" ResizeDirection="Columns"/>

            <!-- KOLOM 4: Detail Panel (Flex-1) -->
            <Border Grid.Column="4" Background="{DynamicResource BrushBgApp}">
                <Grid>
                    <!-- Empty State when nothing selected -->
                    <Grid x:Name="CredDetailEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="44" Height="44" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="22" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconKey}" Fill="{DynamicResource BrushTextFaint}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pilih item untuk melihat kredensial" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kredensial dienkripsi AES-256 secara lokal dan zero-knowledge." FontSize="11" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Active Detail State -->
                    <Grid x:Name="CredDetailActiveState" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Detail Top Header -->
                        <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="42" Height="42" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="ImgDetailCustomIcon" Width="26" Height="26" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path x:Name="IconDetailService" Data="{StaticResource IconKey}" Fill="{DynamicResource BrushAccentBlue}" Width="24" Height="24" Stretch="Uniform" SnapsToDevicePixels="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <WrapPanel VerticalAlignment="Center">
