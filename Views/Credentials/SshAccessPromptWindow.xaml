<Window x:Class="WhatInsides.Views.Credentials.SshAccessPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhatInsides Access Requested"
        Width="460" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource FontSans}"
        Foreground="{DynamicResource BrushTextPrimary}"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Border Background="{DynamicResource BrushBgCard}" 
            BorderBrush="{DynamicResource BrushBorder}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Direction="270" ShadowDepth="10" Opacity="0.9" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <!-- Title Header -->
                <RowDefinition Height="Auto"/>
                <!-- Visual Connection Diagram -->
                <RowDefinition Height="Auto"/>
                <!-- Request Subtitle -->
                <RowDefinition Height="Auto"/>
                <!-- SSH Key Info Card -->
                <RowDefinition Height="Auto"/>
                <!-- Options Checkbox -->
                <RowDefinition Height="Auto"/>
                <!-- Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Title -->
            <TextBlock Grid.Row="0" 
                       Text="WhatInsides Access Requested" 
                       FontSize="15" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource BrushTextPrimary}" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- 2. Visual Diagram: Terminal (Left) -> Green Checkmark (Center) -> Lock (Right) -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Left Box: Terminal -->
                    <Border Width="48" Height="48" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                        <TextBlock Text="$_" FontFamily="{DynamicResource FontMono}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Connecting Line with Center Checkmark Badge -->
                    <Grid Width="70" Height="24" VerticalAlignment="Center">
                        <!-- Horizontal Line -->
                        <Border Height="1.5" Background="{DynamicResource BrushBorderSubtle}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        <!-- Center Badge -->
                        <Border Width="20" Height="20" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Right Box: Padlock -->
                    <Border Width="48" Height="48" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextSecondary}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3. Subtitle / App Request Notice -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="Allow " FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                <TextBlock x:Name="TxtAppRequester" Text="Windows Terminal" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text=" to use SSH key" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>

            <!-- 4. SSH Key Detail Card (Stitch Component) -->
            <Border Grid.Row="3" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Box with Mini Key Overlay -->
                    <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="&gt;_" FontFamily="{DynamicResource FontMono}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Mini Key Badge on Bottom Right -->
                        <Border Width="14" Height="14" Background="#78350F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                            <Path Data="{StaticResource IconKey}" Fill="#F59E0B" Width="7" Height="7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Key Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtKeyTitle" Text="GitHub SSH Key" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtKeyFingerprint" Text="id_ed25519 • SHA256:4vK9z2...e9X2mQ" FontFamily="{DynamicResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Options Checkbox -->
            <CheckBox x:Name="ChkApproveAll" 
                      Grid.Row="4" 
                      Style="{StaticResource StarkCheckBox}" 
                      Content="Approve for all applications" 
                      FontSize="11.5" 
                      Foreground="{DynamicResource BrushTextMuted}" 
                      Margin="2,0,0,18" 
                      Cursor="Hand"/>

            <!-- 6. Action Buttons -->
            <Grid Grid.Row="5">
                <Button x:Name="BtnDeny" 
                        Click="BtnDeny_Click" 
                        Style="{StaticResource StarkSecondaryButton}" 
                        Content="Tolak" 
                        Height="34" 
                        Width="90" 
                        HorizontalAlignment="Left"
                        ToolTip="Batalkan permintaan akses (Esc)"/>

                <Button x:Name="BtnApprove" 
                        Click="BtnApprove_Click" 
                        Style="{StaticResource StarkPrimaryButton}" 
                        Content="Izinkan Akses" 
                        Height="34" 
                        Width="130" 
                        HorizontalAlignment="Right"
                        ToolTip="Izinkan penggunaan kunci SSH (Enter)"/>
            </Grid>
        </Grid>
    </Border>
</Window>
