<Window x:Class="WhatInsides.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WhatInsides"
        xmlns:dash="clr-namespace:WhatInsides.Views.Dashboard"
        xmlns:cred="clr-namespace:WhatInsides.Views.Credentials"
        xmlns:set="clr-namespace:WhatInsides.Views.Settings"
        mc:Ignorable="d"
        Title="WhatInsides - Minimal Stark"
        Icon="Assets/app.png"
        Height="760" Width="1220"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgApp}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontSans}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource BrushBgApp}">
        <Grid.RowDefinitions>
            <!-- TitleBar -->
            <RowDefinition Height="42" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- TOP APP BAR / WINDOW TITLEBAR (STITCH STYLE) -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="WhatInsides" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center Compact Search Box -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="360" VerticalAlignment="Center">
                    <TextBox x:Name="TbGlobalSearch" TextChanged="TbGlobalSearch_TextChanged" Style="{StaticResource StarkTextBox}" Height="28" Padding="26,4,66,4" FontSize="11.5"/>
                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextFaint}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtGlobalSearchPlaceholder" Text="Cari berkas terkunci, folder, partisi..." FontSize="11" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding Text.IsEmpty, ElementName=TbGlobalSearch, Converter={StaticResource BoolToVisConv}}"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center" 
                                Margin="0,0,5,0" 
                                IsHitTestVisible="False"
                                Visibility="{Binding Text.IsEmpty, ElementName=TbGlobalSearch, Converter={StaticResource BoolToVisConv}}">
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Height="20" Padding="5,0" Margin="0,0,3,0">
                            <TextBlock Text="Ctrl" FontFamily="Segoe UI, Inter, sans-serif" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Height="20" Width="20">
                            <TextBlock Text="K" FontFamily="Segoe UI, Inter, sans-serif" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Window Actions / Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                    <!-- Light / Dark Mode Toggle Button -->
                    <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" ToolTip="Ganti Tema Terang / Gelap" Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                        <Path x:Name="PathThemeIcon" Data="{StaticResource IconMoon}" Fill="{DynamicResource BrushTextSecondary}" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <!-- Minimize -->
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="34" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Path Data="{StaticResource IconMinimize}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>

                    <!-- Maximize -->
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="34" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border BorderBrush="{DynamicResource BrushTextSecondary}" BorderThickness="1" Width="10" Height="10" CornerRadius="1"/>
                    </Button>

                    <!-- Close -->
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MAIN APP BODY (SIDEBAR + CONTENT) -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (240px) -->
                <ColumnDefinition Width="240" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT SIDEBAR (STITCH SCREEN 0f06856cbea64400) -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- RUANG KERJA Header -->
                        <TextBlock Text="RUANG KERJA" FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" Margin="8,0,0,6"/>

                        <!-- Navigation Items -->
                        <StackPanel Margin="0,0,0,0">
                            <!-- Nav 1: Dashboard Berkas (Active) -->
                            <Button x:Name="NavBtnDashboard" Click="NavBtnDashboard_Click" Style="{StaticResource SidebarNavActive}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconNavDashboard" Data="{StaticResource IconFolderSupervised}" Fill="{DynamicResource BrushTextPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavDashboard" Text="Dashboard Berkas" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav 2: Kata Sandi -->
                            <Button x:Name="NavBtnCredentials" Click="NavBtnCredentials_Click" Style="{StaticResource SidebarNavInactive}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconNavCredentials" Data="{StaticResource IconKey}" Fill="{DynamicResource BrushTextFaint}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavCredentials" Text="Kata Sandi" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav 3: Pengaturan -->
                            <Button x:Name="NavBtnSettings" Click="NavBtnSettings_Click" Style="{StaticResource SidebarNavInactive}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconNavSettings" Data="{StaticResource IconTune}" Fill="{DynamicResource BrushTextFaint}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavSettings" Text="Pengaturan" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom: Kunci Semua Sekarang Button -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Button x:Name="BtnSidebarLockAll" Click="BtnLockAll_Click" Style="{StaticResource StarkPrimaryButton}" Height="34" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushPrimaryText}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kunci Semua Sekarang" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- RIGHT MAIN PANEL: COMPONENT VIEWS & MODALS -->
            <!-- ============================================== -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushBgApp}">

                <!-- ========================================== -->
                <!-- 1. LOGIN SCREEN (WHEN APP IS LOCKED) -->
                <!-- ========================================== -->
                <Grid x:Name="PanelAuth" Visibility="Collapsed" Background="{DynamicResource BrushBgApp}">
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                        <StackPanel>
                            <Border Width="48" Height="48" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Data="{StaticResource IconShieldLock}" Fill="{DynamicResource BrushTextPrimary}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Buka Kunci WhatInsides" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Masukkan Master Password untuk mengakses brankas in-place" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <TextBlock Text="Password Master:" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PbMasterAuth" Style="{StaticResource StarkPasswordBox}" Height="34" Margin="0,0,0,14" KeyDown="PbMasterAuth_KeyDown"/>

                            <TextBlock x:Name="TxtAuthError" Text="Password salah! Silakan coba lagi." FontSize="11.5" Foreground="{DynamicResource BrushDanger}" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>

                            <Button x:Name="BtnUnlockApp" Click="BtnUnlockApp_Click" Style="{StaticResource StarkPrimaryButton}" Content="Masuk ke Dashboard" Height="36" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. MODULAR COMPONENT VIEWS -->
                <!-- ========================================== -->
                <dash:FileVaultView x:Name="ViewDashboard" Visibility="Visible"/>
                <cred:CredentialView x:Name="ViewCredentials" Visibility="Collapsed"/>
                <set:SettingsView x:Name="ViewSettings" Visibility="Collapsed"/>

                <!-- ========================================== -->
                <!-- 3. MODAL: KUNCI BARU QUICK PROMPT (EXPLORER INTEGRATION) -->
                <!-- ========================================== -->
                <Grid x:Name="OverlayNewLock" Visibility="Collapsed" Background="#C0000000">
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                        <StackPanel>
                            <!-- Header Section -->
                            <TextBlock Text="Kunci Berkas atau Folder" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Pilih berkas atau folder untuk mengamankan data secara langsung di drive asalnya." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,18"/>

                            <!-- Target File Badge -->
                            <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,16">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtModalTargetName" Text="Target" FontWeight="Medium" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="TxtModalTargetPath" Text="C:\" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextFaint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Side-by-Side Mode Picker -->
                            <TextBlock Text="PILIH MODE PROTEKSI" FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextFaint}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card Mode B: Kunci Cepat Instan -->
                                <Border x:Name="CardModeFast" MouseDown="CardModeFast_MouseDown" Grid.Column="0" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1.5" CornerRadius="6" Padding="14" Cursor="Hand">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton x:Name="RbModeFast" GroupName="QuickLockMode" Checked="RbModeFast_Checked" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Mode Cepat" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                <TextBlock Text="&lt;0.1s" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Penguncian instan tanpa proses duplikasi atau pemindahan. Folder langsung hilang dari Explorer." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card Mode C: Mode Enkripsi AES-256 -->
                                <Border x:Name="CardModeAes" MouseDown="CardModeAes_MouseDown" Grid.Column="2" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Cursor="Hand">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton x:Name="RbModeAes" GroupName="QuickLockMode" Checked="RbModeAes_Checked" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Mode Enkripsi" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                <TextBlock Text="AES-256" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Enkripsi penuh untuk keamanan dokumen sensitif. Mustahil dibobol sekalipun hard disk dicopot." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Checkboxes -->
                            <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
                                <StackPanel>
                                    <CheckBox x:Name="ChkShred" IsChecked="True" Content="Hancurkan file asli setelah enkripsi selesai" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8" Cursor="Hand"/>
                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkAutoRelock" IsChecked="True" Content="Kunci otomatis saat aplikasi ditutup" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <Grid>
                                <Button x:Name="BtnCancelModal" Click="BtnCancelModal_Click" Style="{StaticResource StarkSecondaryButton}" Content="Batal" HorizontalAlignment="Left" Width="80"/>
                                <Button x:Name="BtnConfirmLock" Click="BtnConfirmLock_Click" Style="{StaticResource StarkPrimaryButton}" Content="Kunci Sekarang" HorizontalAlignment="Right" Width="130"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- 4. GLOBAL TOAST NOTIFICATION -->
                <!-- ========================================== -->
                <Border x:Name="SettingsToast" Visibility="Collapsed" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,24,24" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtToastTitle" Text="Konfigurasi Disimpan" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="TxtToastDesc" Text="Parameter diperbarui ke registry lokal." FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
