<Window x:Class="WhatInsides.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WhatInsides"
        mc:Ignorable="d"
        Title="WhatInsides - Minimal Stark"
        Icon="Assets/app.png"
        Height="720" Width="1120"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgApp}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontSans}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource BrushBgApp}">
        <Grid.RowDefinitions>
            <!-- TitleBar -->
            <RowDefinition Height="42" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- TOP APP BAR / WINDOW TITLEBAR (STITCH STYLE) -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="WhatInsides" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TEMA 2: MINIMAL STARK (BUN STYLE)" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"/>
                    </Border>
                </StackPanel>

                <!-- Center Compact Search Box -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="360" VerticalAlignment="Center">
                    <TextBox x:Name="TbGlobalSearch" TextChanged="TbGlobalSearch_TextChanged" KeyDown="TbGlobalSearch_KeyDown" Style="{StaticResource StarkTextBox}" Height="28" Padding="26,4,66,4" FontSize="11.5"/>
                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextFaint}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Cari berkas terkunci, folder, partisi..." FontSize="11" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding Text.IsEmpty, ElementName=TbGlobalSearch, Converter={StaticResource BoolToVisConv}}"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center" 
                                Margin="0,0,5,0" 
                                IsHitTestVisible="False"
                                Visibility="{Binding Text.IsEmpty, ElementName=TbGlobalSearch, Converter={StaticResource BoolToVisConv}}">
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Height="20" Padding="5,0" Margin="0,0,3,0">
                            <TextBlock Text="Ctrl" FontFamily="Segoe UI, Inter, sans-serif" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Height="20" Width="20">
                            <TextBlock Text="K" FontFamily="Segoe UI, Inter, sans-serif" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Window Actions / Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                    <!-- Light / Dark Mode Toggle Button -->
                    <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" ToolTip="Ganti Tema Terang / Gelap" Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                        <Path x:Name="PathThemeIcon" Data="{StaticResource IconMoon}" Fill="{DynamicResource BrushTextSecondary}" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <!-- Minimize -->
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="34" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Path Data="{StaticResource IconMinimize}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>

                    <!-- Maximize -->
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="34" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Border BorderBrush="{DynamicResource BrushTextSecondary}" BorderThickness="1" Width="10" Height="10" CornerRadius="1"/>
                    </Button>

                    <!-- Close -->
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MAIN APP BODY (SIDEBAR + CONTENT) -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (240px per Stitch w-60) -->
                <ColumnDefinition Width="240" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT SIDEBAR (STITCH SCREEN 0f06856cbea64400) -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- RUANG KERJA Header -->
                        <TextBlock Text="RUANG KERJA" FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" Margin="8,0,0,6"/>

                        <!-- Navigation Items -->
                        <StackPanel Margin="0,0,0,0">
                            <!-- Nav 1: Dashboard Berkas (Active) -->
                            <Button x:Name="NavBtnDashboard" Click="NavBtnDashboard_Click" Style="{StaticResource SidebarNavActive}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconNavDashboard" Data="{StaticResource IconFolderSupervised}" Fill="{DynamicResource BrushTextPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavDashboard" Text="Dashboard Berkas" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav 2: Kunci Baru -->
                            <Button x:Name="NavBtnNewLock" Click="NavBtnNewLock_Click" Style="{StaticResource SidebarNavInactive}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconNavNewLock" Data="{StaticResource IconEnhancedEncryption}" Fill="{DynamicResource BrushTextFaint}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavNewLock" Text="Kunci Baru" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav 3: Integrasi Shell -->
                            <Button x:Name="NavBtnShell" Click="NavBtnShell_Click" Style="{StaticResource SidebarNavInactive}" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconNavShell" Data="{StaticResource IconTerminal}" Fill="{DynamicResource BrushTextFaint}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavShell" Text="Integrasi Shell" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Nav 4: Pengaturan -->
                            <Button x:Name="NavBtnSettings" Click="NavBtnSettings_Click" Style="{StaticResource SidebarNavInactive}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconNavSettings" Data="{StaticResource IconTune}" Fill="{DynamicResource BrushTextFaint}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavSettings" Text="Pengaturan" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom: Kunci Semua Sekarang Button (Stitch screens 1:1) -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Button x:Name="BtnSidebarLockAll" Click="BtnLockAll_Click" Style="{StaticResource StarkPrimaryButton}" Height="34" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushPrimaryText}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kunci Semua Sekarang" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- RIGHT MAIN PANEL: CONTENT VIEWS -->
            <!-- ============================================== -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushBgApp}">

                <!-- ========================================== -->
                <!-- 1. LOGIN SCREEN (WHEN APP IS LOCKED) -->
                <!-- ========================================== -->
                <Grid x:Name="PanelAuth" Visibility="Collapsed" Background="{DynamicResource BrushBgApp}">
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                        <StackPanel>
                            <Border Width="48" Height="48" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Data="{StaticResource IconShieldLock}" Fill="{DynamicResource BrushTextPrimary}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Buka Kunci WhatInsides" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Masukkan Master Password untuk mengakses brankas in-place" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <TextBlock Text="Password Master:" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PbMasterAuth" Style="{StaticResource StarkPasswordBox}" Height="34" Margin="0,0,0,14" KeyDown="PbMasterAuth_KeyDown"/>

                            <TextBlock x:Name="TxtAuthError" Text="Password salah! Silakan coba lagi." FontSize="11.5" Foreground="{DynamicResource BrushDanger}" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>

                            <Button x:Name="BtnUnlockApp" Click="BtnUnlockApp_Click" Style="{StaticResource StarkPrimaryButton}" Content="Masuk ke Dashboard" Height="36" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. DASHBOARD BERKAS (SCREEN 0f06856cbea64400) -->
                <!-- ========================================== -->
                <Grid x:Name="PanelDashboard" Visibility="Visible" Margin="28,20,28,24">
                    <Grid.RowDefinitions>
                        <!-- Action Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Data Table -->
                        <RowDefinition Height="*"/>
                        <!-- Dropzone Target -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Explorer Action Toolbar -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,2,0,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnToolbarNew" Click="BtnToolbarNew_Click" Style="{StaticResource StarkPrimaryButton}" Height="28" Padding="12,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource BrushPrimaryText}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Baru" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnToolbarAddFolder" Click="BtnToolbarAddFolder_Click" Style="{StaticResource StarkGhostButton}" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconUpload}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Unggah" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="|" Foreground="{DynamicResource BrushBorderSubtle}" VerticalAlignment="Center" Margin="4,0,8,0"/>

                                <Button x:Name="BtnToolbarDiskFilter" Click="BtnToolbarDiskFilter_Click" Style="{StaticResource StarkGhostButton}" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDesktopWindows}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtToolbarDiskLabel" Text="Semua Disk" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="CmDiskFilter" Style="{StaticResource StarkContextMenu}">
                                            <MenuItem Header="Semua Disk / Partisi" Click="MenuItemDiskFilter_Click" Tag="ALL" IsChecked="True"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Button x:Name="BtnToolbarSort" Click="BtnToolbarSort_Click" Style="{StaticResource StarkGhostButton}" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSort}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtToolbarSortLabel" Text="Urutkan" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource StarkContextMenu}">
                                            <MenuItem Header="Nama (A - Z)" Click="MenuItemSort_Click" Tag="NameAsc"/>
                                            <MenuItem Header="Nama (Z - A)" Click="MenuItemSort_Click" Tag="NameDesc"/>
                                            <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="4,2"/>
                                            <MenuItem Header="Tanggal Terbaru" Click="MenuItemSort_Click" Tag="DateDesc"/>
                                            <MenuItem Header="Tanggal Terlama" Click="MenuItemSort_Click" Tag="DateAsc"/>
                                            <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="4,2"/>
                                            <MenuItem Header="Ukuran Terbesar" Click="MenuItemSort_Click" Tag="SizeDesc"/>
                                            <MenuItem Header="Ukuran Terkecil" Click="MenuItemSort_Click" Tag="SizeAsc"/>
                                            <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="4,2"/>
                                            <MenuItem Header="Tipe / Ekstensi" Click="MenuItemSort_Click" Tag="TypeAsc"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Button x:Name="BtnToolbarViewMode" Click="BtnToolbarViewMode_Click" Style="{StaticResource StarkGhostButton}" Height="28" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path x:Name="IconToolbarViewMode" Data="{StaticResource IconGridView}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtToolbarViewMode" Text="Tampilan" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnRefreshList" Click="BtnRefreshList_Click" ToolTip="Muat Ulang Berkas" Style="{StaticResource StarkGhostButton}" Height="28">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Muat Ulang" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Dynamic Disk Filter Pills in Table Toolbar -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="10,0,10,0" VerticalAlignment="Center">
                                <StackPanel x:Name="SpDiskFilterPills" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ScrollViewer>

                            <Button x:Name="BtnToolbarLockVault" Grid.Column="2" Click="BtnToolbarLockVault_Click" Style="{StaticResource DangerOutlineButton}" Height="28" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushDanger}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kunci Brankas" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Data Table Container -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Table Header -->
                                <RowDefinition Height="32"/>
                                <!-- Items List -->
                                <RowDefinition Height="*"/>
                                <!-- Table Footer -->
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Border x:Name="BorderTableHeader" Grid.Row="0" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                <Grid Margin="16,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ColHeaderName" Grid.Column="0" Text="Nama ▾" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ColHeader_Click" Tag="Name" ToolTip="Klik untuk mengurutkan berdasarkan Nama"/>
                                    <TextBlock x:Name="ColHeaderDate" Grid.Column="1" Text="Tanggal Dimodifikasi" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ColHeader_Click" Tag="Date" ToolTip="Klik untuk mengurutkan berdasarkan Tanggal"/>
                                    <TextBlock x:Name="ColHeaderType" Grid.Column="2" Text="Tipe" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ColHeader_Click" Tag="Type" ToolTip="Klik untuk mengurutkan berdasarkan Tipe Berkas"/>
                                    <TextBlock x:Name="ColHeaderSize" Grid.Column="3" Text="Ukuran" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" TextAlignment="Right" Cursor="Hand" MouseLeftButtonUp="ColHeader_Click" Tag="Size" ToolTip="Klik untuk mengurutkan berdasarkan Ukuran"/>
                                    <TextBlock Grid.Column="4" Text="Status / Aksi" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Grid/Card View (Alternative to Details Table) -->
                            <ScrollViewer x:Name="SvGridLockedItems" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="IcGridLockedItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" Margin="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="210" Margin="6" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Cursor="Hand">
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource StarkContextMenu}">
                                                        <MenuItem Header="Buka Sementara (Preview)" Click="MenuItemPreview_Click"/>
                                                        <MenuItem Header="Buka di File Explorer" Click="MenuItemReveal_Click"/>
                                                        <MenuItem Header="Salin Path Berkas" Click="MenuItemCopyPath_Click"/>
                                                        <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="4,2"/>
                                                        <MenuItem Header="Pulihkan Permanen" Click="MenuItemRestore_Click"/>
                                                        <MenuItem Header="Hancurkan Permanen" Click="MenuItemShred_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Icon & Badge -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                                        <Border Width="26" Height="26" Background="{DynamicResource BrushBgCard}" CornerRadius="4" HorizontalAlignment="Left">
                                                            <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushAccentBlue}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border HorizontalAlignment="Right" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                                            <TextBlock Text="{Binding LockTypeBadge}" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Name -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                    <!-- Path -->
                                                    <TextBlock Grid.Row="2" Text="{Binding OriginalPath}" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource BrushTextFaint}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                                    <!-- Bottom: Size, Date & Actions -->
                                                    <Grid Grid.Row="3">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FormattedSize}" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                            <TextBlock Text="{Binding FormattedDate}" FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="{DynamicResource BrushTextFaint}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button ToolTip="Buka Sementara" Click="BtnItemPreview_Click" Tag="{Binding}" Style="{StaticResource StarkSecondaryButton}" Width="24" Height="24" Padding="0" Margin="0,0,4,0">
                                                                <Path Data="{StaticResource IconEye}" Fill="{DynamicResource BrushAccentBlue}" Width="11" Height="11" Stretch="Uniform"/>
                                                            </Button>
                                                            <Button ToolTip="Pulihkan Permanen" Click="BtnItemRestore_Click" Tag="{Binding}" Style="{StaticResource StarkSecondaryButton}" Width="24" Height="24" Padding="0">
                                                                <Path Data="{StaticResource IconUnlock}" Fill="{DynamicResource BrushSuccess}" Width="11" Height="11" Stretch="Uniform"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- ListView Items -->
                            <ListView x:Name="LvLockedItems" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                                        <Setter Property="Padding" Value="16,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu Style="{StaticResource StarkContextMenu}">
                                                    <MenuItem Header="Buka Sementara (Preview)" Click="MenuItemPreview_Click">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconEye}" Fill="{DynamicResource BrushAccentBlue}" Width="12" Height="12" Stretch="Uniform"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Buka di File Explorer" Click="MenuItemReveal_Click">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Salin Path Berkas" Click="MenuItemCopyPath_Click">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconDescription}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="4,2"/>
                                                    <MenuItem Header="Pulihkan Permanen (Unhide/Decrypt)" Click="MenuItemRestore_Click">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconUnlock}" Fill="{DynamicResource BrushSuccess}" Width="12" Height="12" Stretch="Uniform"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Hancurkan Permanen (DoD Secure Shred)" Click="MenuItemShred_Click">
                                                        <MenuItem.Icon>
                                                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushDanger}" Width="11" Height="11" Stretch="Uniform"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Name & Path -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" Background="{DynamicResource BrushBgApp}" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushAccentBlue}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="2" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DriveLetter}" FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding OriginalPath}" FontFamily="{DynamicResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushTextFaint}" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Date -->
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>

                                            <!-- Type Badge -->
                                            <Border Grid.Column="2" HorizontalAlignment="Left" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LockTypeBadge}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </Border>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" TextAlignment="Right"/>

                                            <!-- Action Buttons (Preview / Restore) -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button ToolTip="Buka Sementara" Click="BtnItemPreview_Click" Tag="{Binding}" Style="{StaticResource StarkSecondaryButton}" Width="26" Height="26" Padding="0" Margin="0,0,4,0">
                                                    <Path Data="{StaticResource IconEye}" Fill="{DynamicResource BrushAccentBlue}" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button ToolTip="Pulihkan Permanen" Click="BtnItemRestore_Click" Tag="{Binding}" Style="{StaticResource StarkSecondaryButton}" Width="26" Height="26" Padding="0">
                                                    <Path Data="{StaticResource IconUnlock}" Fill="{DynamicResource BrushSuccess}" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State Panel -->
                            <Grid x:Name="PanelEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Margin="0,30">
                                    <Border Width="38" Height="38" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="19" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Path Data="{StaticResource IconShieldLock}" Fill="{DynamicResource BrushTextFaint}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtEmptyTitle" Text="Brankas Masih Kosong" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtEmptyDesc" Text="Kunci berkas atau folder secara in-place di partisi asalnya (Drive D:\ atau C:\)" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Table Footer -->
                            <Border Grid.Row="2" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,0">
                                <Grid VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtFooterCount" Text="0 item" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                        <TextBlock Text=" | In-place proteksi aktif tanpa membebani drive C:\" FontSize="11" Foreground="{DynamicResource BrushTextFaint}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Stark Minimal Drop Target (Stitch Screen 0f06856cbea64400) -->
                    <Border x:Name="DropZone" Grid.Row="2" 
                            AllowDrop="True"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            Drop="DropZone_Drop"
                            BorderBrush="{DynamicResource BrushBorderSubtle}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="16,10" 
                            Background="Transparent" 
                            Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAddCircle}" Fill="{DynamicResource BrushTextFaint}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tarik berkas atau folder ke sini untuk mengunci secara in-place" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="BtnPickQuick" Grid.Column="1" Click="BtnToolbarAddFolder_Click" Content="Pilih berkas..." Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="11" FontWeight="Medium" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- 3. SCREEN: KUNCI BARU (STITCH SCREEN f59aa4bc8e974b1c) -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelNewLock" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="1152" Margin="36,28,36,48" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <!-- Header Section -->
                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,28">
                                <StackPanel>
                                    <TextBlock Text="Kunci Berkas atau Folder" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Pilih berkas atau folder untuk mengamankan data secara langsung di drive asalnya." FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </Border>

                            <!-- Minimal Stark Dropzone (Bun-inspired code/terminal vibe) -->
                            <Border x:Name="DropZoneNewLock"
                                    AllowDrop="True"
                                    DragEnter="DropZoneNewLock_DragEnter"
                                    DragLeave="DropZoneNewLock_DragLeave"
                                    Drop="DropZoneNewLock_Drop"
                                    BorderBrush="{DynamicResource BrushBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Background="{DynamicResource BrushBgCard}" 
                                    Padding="32" 
                                    Margin="0,0,0,28" 
                                    Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconUploadFile}" Fill="{DynamicResource BrushTextPrimary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Seret dan lepaskan file atau folder ke sini" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Atau telusuri berkas dari perangkat Anda" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="BtnPickFileNewLock" Click="BtnPickFileNewLock_Click" Style="{StaticResource StarkSecondaryButton}" Height="30" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconDescription}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Pilih File" FontSize="11.5" FontFamily="{DynamicResource FontMono}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnPickFolderNewLock" Click="BtnPickFolderNewLock_Click" Style="{StaticResource StarkSecondaryButton}" Height="30">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFolderOpen}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Pilih Folder" FontSize="11.5" FontFamily="{DynamicResource FontMono}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Target Files List (Compact Monospace bun-style) -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="OBJEK TERPILIH" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}"/>
                                    <TextBlock x:Name="TxtNewLockTargetCount" Text="(0)" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnClearAllQueue" Click="BtnClearAllQueue_Click" Style="{StaticResource StarkGhostButton}" Height="22" Padding="6,2" HorizontalAlignment="Right" Content="Kosongkan Antrean" FontSize="10.5" Visibility="Collapsed"/>
                            </Grid>

                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                            <!-- Selected Items Container (Dynamic ObservableCollection) -->
                            <StackPanel x:Name="ContainerNewLockTargets" Margin="0,0,0,28">
                                <ItemsControl x:Name="IcNewLockQueue" ItemsSource="{Binding LockQueueItems, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{Binding Category, Converter={StaticResource CatToGeometryConv}}" Fill="{DynamicResource BrushTextMuted}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Foreground="{DynamicResource BrushTextFaint}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FormattedSize}" Grid.Column="1" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="12,0"/>
                                                    <Button Click="BtnRemoveQueueItem_Click" Tag="{Binding}" Grid.Column="2" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Hapus dari antrean">
                                                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextFaint}" Width="10" Height="10" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty Cue when queue is 0 -->
                                <Border x:Name="BorderQueueEmptyCue" Visibility="Visible" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                                    <TextBlock Text="Belum ada objek yang dipilih. Seret file/folder ke dropzone di atas atau klik tombol telusuri." FontSize="11.5" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Mode Picker Header -->
                            <TextBlock Text="PILIH MODE PROTEKSI" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextFaint}" Margin="0,0,0,12"/>

                            <!-- Side-by-side Cards -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mode B: Mode Cepat -->
                                <Border x:Name="CardNewLockModeFast" MouseDown="CardNewLockModeFast_MouseDown" Grid.Column="0" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1.5" CornerRadius="8" Padding="16" Cursor="Hand">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="14" Height="14" CornerRadius="7" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse x:Name="DotModeFast" Width="6" Height="6" Fill="{DynamicResource BrushPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Mode Cepat" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="&lt;0.1s" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Penguncian instan tanpa proses duplikasi atau pemindahan." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mode C: Mode Enkripsi -->
                                <Border x:Name="CardNewLockModeAes" MouseDown="CardNewLockModeAes_MouseDown" Grid.Column="2" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16" Cursor="Hand">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="14" Height="14" CornerRadius="7" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse x:Name="DotModeAes" Width="6" Height="6" Fill="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Mode Enkripsi" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="AES-256" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Enkripsi penuh untuk keamanan dokumen sensitif." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" LineHeight="18"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Checkbox Options Card -->
                            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,28">
                                <StackPanel>
                                    <CheckBox x:Name="ChkShredFull" Style="{StaticResource StarkCheckBox}" IsChecked="True" Content="Hancurkan file asli setelah enkripsi selesai" Margin="0,0,0,10"/>
                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkAutoRelockFull" Style="{StaticResource StarkCheckBox}" IsChecked="True" Content="Kunci otomatis saat aplikasi ditutup"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Bar -->
                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                <Grid>
                                    <Button x:Name="BtnCancelNewLockScreen" Click="NavBtnDashboard_Click" Style="{StaticResource StarkGhostButton}" Content="Batal" HorizontalAlignment="Left" FontSize="12.5"/>
                                    <Button x:Name="BtnExecuteNewLock" Click="BtnExecuteNewLock_Click" Style="{StaticResource StarkPrimaryButton}" Height="34" Padding="18,0" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushPrimaryText}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Kunci Sekarang" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ========================================== -->
                <!-- 4. SCREEN: INTEGRASI SHELL & WINDOWS (STITCH SCREEN 1e03c1900e994c2f) -->
                <!-- ========================================== -->
                <ScrollViewer x:Name="PanelShell" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="1152" Margin="36,28,36,48" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <!-- Header Section -->
                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,28">
                                <StackPanel>
                                    <TextBlock Text="Integrasi Windows Shell" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Kelola ekstensi menu klik kanan Windows Explorer dan verifikasi alokasi storage in-place tanpa overhead drive sistem." FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 1: Explorer Context Menu Card -->
                            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Menu Klik Kanan Explorer" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Aktifkan pintasan langsung di Windows Explorer untuk mengunci berkas atau folder secara instan tanpa membuka jendela aplikasi utama." FontSize="12.5" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>
                                        <TextBlock Text="HKCU\Software\Classes\*\shell\WhatInsides" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextFaint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkShellToggle" Click="ChkShellToggle_Click" Grid.Column="1" Style="{StaticResource StarkToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Section 2: Status & Alokasi Partisi Header -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Status &amp; Alokasi Partisi" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="Langsung pada metadata volume NTFS tanpa overhead duplikasi data." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Partisi Drive Table -->
                            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,28">
                                <StackPanel>
                                    <!-- Drive C: Row -->
                                    <Border Padding="16,14" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="C:\" FontFamily="{DynamicResource FontMono}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock x:Name="TxtShellDriveCLabel" Text="SSD Sistem" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtShellDriveCLocked" Text="0 MB Overhead" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="#10B981" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0,24,0" VerticalAlignment="Center">
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock x:Name="TxtShellDriveCUsage" Text="72 GB used" FontFamily="{DynamicResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"/>
                                                    <TextBlock x:Name="TxtShellDriveCTotalPercent" Text="256 GB total (28%)" FontFamily="{DynamicResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushTextFaint}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border Height="4" Background="{DynamicResource BrushBgApp}" CornerRadius="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition x:Name="ColShellDriveCUsed" Width="28*"/>
                                                            <ColumnDefinition x:Name="ColShellDriveCFree" Width="72*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource BrushTextMuted}" CornerRadius="2"/>
