<Window x:Class="WhatInsides.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WhatInsides"
        mc:Ignorable="d"
        Title="WhatInsides - Buka Kunci Brankas"
        Icon="Assets/app.png"
        Width="460" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgApp}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar -->
                <RowDefinition Height="40" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- WINDOW TITLEBAR (STITCH THEME 2) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand / Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="WhatInsides" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TERKUNCI" FontFamily="JetBrains Mono, monospace" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <!-- Light/Dark Mode Toggle -->
                        <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" ToolTip="Ganti Tema Terang / Gelap" Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                            <Path x:Name="PathThemeIcon" Data="{StaticResource IconSun}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <!-- Minimize -->
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0">
                            <Path Data="{StaticResource IconMinimize}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>

                        <!-- Close -->
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="34" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- UNLOCK CARD CONTENT (SCREEN 0258ae6aebe24c438) -->
            <!-- ============================================== -->
            <Grid Grid.Row="1" Margin="32,24,32,28">
                <Grid.RowDefinitions>
                    <!-- Avatar & Headers -->
                    <RowDefinition Height="Auto" />
                    <!-- Password Form -->
                    <RowDefinition Height="Auto" />
                    <!-- Alternative Auth -->
                    <RowDefinition Height="Auto" />
                    <!-- Actions -->
                    <RowDefinition Height="Auto" />
                    <!-- Recovery Footer -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TOP AVATAR & TITLES -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <!-- Security Avatar -->
                    <Border Width="54" Height="54" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextPrimary}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Buka Kunci Dokumen Pribadi" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <!-- Subtitle -->
                    <TextBlock Text="Masukkan kata sandi master untuk memasang virtual drive terenkripsi" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" LineHeight="17" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- MASTER PASSWORD FORM -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <!-- Label -->
                    <TextBlock Text="KATA SANDI MASTER" FontFamily="JetBrains Mono, monospace" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,7"/>

                    <!-- Password Input Container -->
                    <Grid Height="38">
                        <PasswordBox x:Name="PbMasterPassword" Style="{StaticResource StarkPasswordBox}" Height="38" Padding="12,6,40,6" FontSize="13" KeyDown="PbMasterPassword_KeyDown" PasswordChanged="PbMasterPassword_PasswordChanged"/>
                        <TextBox x:Name="TbMasterPasswordPeek" Style="{StaticResource StarkTextBox}" Height="38" Padding="12,6,40,6" FontSize="13" Visibility="Collapsed" KeyDown="TbMasterPasswordPeek_KeyDown" TextChanged="TbMasterPasswordPeek_TextChanged"/>

                        <!-- Placeholder -->
                        <TextBlock x:Name="TxtPlaceholder" Text="Ketik kata sandi..." FontSize="12.5" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>

                        <!-- Eye Toggle Button -->
                        <Button x:Name="BtnTogglePeek" Click="BtnTogglePeek_Click" HorizontalAlignment="Right" Width="36" Height="36" Margin="0,0,1,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Tampilkan atau sembunyikan kata sandi">
                            <Path x:Name="PathPeekIcon" Data="{StaticResource IconEye}" Fill="{DynamicResource BrushTextMuted}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Security Footnote -->
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Path Data="{StaticResource IconKey}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="XChaCha20-Poly1305 • Terisolasi di memori" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Error Alert Banner -->
                    <Border x:Name="BorderError" Background="#20EF4444" BorderBrush="{DynamicResource BrushDanger}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconAlertCircle}" Fill="{DynamicResource BrushDanger}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtError" Text="Kata sandi master salah! Silakan coba lagi." FontSize="11.5" Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ALTERNATIVE AUTHENTICATION -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="METODE AUTENTIKASI LAINNYA" FontFamily="JetBrains Mono, monospace" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Option 1: Windows Hello -->
                        <Button x:Name="BtnWindowsHello" Grid.Column="0" Click="BtnWindowsHello_Click" Cursor="Hand" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="10,8" HorizontalContentAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushTextFaint}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="30" Height="30" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFingerprint}" Fill="{DynamicResource BrushTextSecondary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="Windows Hello" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Biometrik / PIN" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Option 2: Key File (.skfs) -->
                        <Button x:Name="BtnKeyFile" Grid.Column="2" Click="BtnKeyFile_Click" Cursor="Hand" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="10,8" HorizontalContentAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushTextFaint}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="30" Height="30" Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconKey}" Fill="{DynamicResource BrushTextSecondary}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="Berkas Kunci" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Pilih .skfs" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ACTION BUTTONS -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <!-- Batal -->
                    <Button x:Name="BtnCancel" Click="BtnCancel_Click" Style="{StaticResource StarkSecondaryButton}" Content="Batal" Width="82" Height="36" Margin="0,0,10,0"/>

                    <!-- Buka Brankas -->
                    <Button x:Name="BtnUnlock" Click="BtnUnlock_Click" Style="{StaticResource StarkPrimaryButton}" Height="36" Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushPrimaryText}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Buka Brankas" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- RECOVERY LINK FOOTER -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,16,0,0">
                    <TextBlock Text="Lupa kata sandi? " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock>
                        <Hyperlink x:Name="LinkRecovery" Click="LinkRecovery_Click" Foreground="{DynamicResource BrushTextSecondary}" TextDecorations="Underline">
                            Gunakan Kunci Pemulihan (Recovery Key)
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
