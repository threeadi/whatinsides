<Window x:Class="WhatInsides.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WhatInsides"
        mc:Ignorable="d"
        Title="WhatInsides - Buka Kunci Brankas"
        Icon="Assets/app.png"
        Width="420" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgApp}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontSans}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BrushBgApp}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar -->
                <RowDefinition Height="40" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- WINDOW TITLEBAR (STITCH THEME 2) -->
            <!-- ============================================== -->
            <Border Grid.Row="0" Background="{DynamicResource BrushBgSidebar}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand / Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="WhatInsides" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <!-- Light/Dark Mode Toggle -->
                        <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" ToolTip="Ganti Tema Terang / Gelap" Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                            <Path x:Name="PathThemeIcon" Data="{StaticResource IconSun}" Fill="{DynamicResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <!-- Minimize -->
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0">
                            <Path Data="{StaticResource IconMinimize}" Fill="{DynamicResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>

                        <!-- Close -->
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="34" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- UNLOCK CARD CONTENT (SCREEN 0258ae6aebe24c438) -->
            <!-- ============================================== -->
            <!-- ============================================== -->
            <!-- UNLOCK CARD CONTENT -->
            <!-- ============================================== -->
            <Grid Grid.Row="1" Margin="32,16,32,24">
                <Grid.RowDefinitions>
                    <!-- Avatar & Headers -->
                    <RowDefinition Height="Auto" />
                    <!-- Password Form -->
                    <RowDefinition Height="Auto" />
                    <!-- Actions -->
                    <RowDefinition Height="Auto" />
                    <!-- Recovery Footer -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TOP AVATAR & TITLES -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <!-- Security Avatar -->
                    <Border Width="50" Height="50" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushTextPrimary}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Buka Kunci WhatInsides" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <!-- Subtitle -->
                    <TextBlock Text="Masukkan kata sandi master untuk mengakses brankas" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- MASTER PASSWORD FORM -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <!-- Label -->
                    <TextBlock Text="KATA SANDI MASTER" FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>

                    <!-- Password Input Container -->
                    <Grid Height="38">
                        <PasswordBox x:Name="PbMasterPassword" Style="{StaticResource StarkPasswordBox}" Height="38" Padding="12,6,40,6" FontSize="13" KeyDown="PbMasterPassword_KeyDown" PasswordChanged="PbMasterPassword_PasswordChanged"/>
                        <TextBox x:Name="TbMasterPasswordPeek" Style="{StaticResource StarkTextBox}" Height="38" Padding="12,6,40,6" FontSize="13" Visibility="Collapsed" KeyDown="TbMasterPasswordPeek_KeyDown" TextChanged="TbMasterPasswordPeek_TextChanged"/>

                        <!-- Placeholder -->
                        <TextBlock x:Name="TxtPlaceholder" Text="Ketik kata sandi..." FontSize="12.5" Foreground="{DynamicResource BrushTextFaint}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>

                        <!-- Eye Toggle Button -->
                        <Button x:Name="BtnTogglePeek" Click="BtnTogglePeek_Click" HorizontalAlignment="Right" Width="36" Height="36" Margin="0,0,1,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Tampilkan atau sembunyikan kata sandi">
                            <Path x:Name="PathPeekIcon" Data="{StaticResource IconEye}" Fill="{DynamicResource BrushTextMuted}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Error Alert Banner -->
                    <Border x:Name="BorderError" Background="#20EF4444" BorderBrush="{DynamicResource BrushDanger}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconAlertCircle}" Fill="{DynamicResource BrushDanger}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtError" Text="Kata sandi master salah! Silakan coba lagi." FontSize="11.5" Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ACTION BUTTONS: BUKA BRANKAS & WINDOWS HELLO -->
                <StackPanel Grid.Row="2" Margin="0,4,0,0">
                    <!-- Buka Brankas (Full Width) -->
                    <Button x:Name="BtnUnlock" Click="BtnUnlock_Click" Style="{StaticResource StarkPrimaryButton}" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLock}" Fill="{DynamicResource BrushPrimaryText}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Buka Brankas" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushPrimaryText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Windows Hello Biometric Button (Full Width Secondary) -->
                    <Button x:Name="BtnWindowsHello" Click="BtnWindowsHello_Click" Style="{StaticResource StarkSecondaryButton}" Height="36" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconFingerprint}" Fill="{DynamicResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Gunakan Windows Hello (Biometrik / PIN)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- RECOVERY LINK FOOTER -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0">
                    <TextBlock Text="Lupa kata sandi? " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock>
                        <Hyperlink x:Name="LinkRecovery" Click="LinkRecovery_Click" Foreground="{DynamicResource BrushTextSecondary}" TextDecorations="Underline">
                            Gunakan Kunci Pemulihan
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
